# Kopieer dit bestand naar .env.local en vul je eigen sleutels in.
# Zonder sleutels draait de app in demo-modus met voorbeelddata.

# Claude API-sleutel (console.anthropic.com). Nodig voor berichten door Claude.
ANTHROPIC_API_KEY=

# Optioneel: welk Claude-model de berichten schrijft.
CLAUDE_MODEL=claude-sonnet-5-5

# Apollo.io API-sleutel (Settings > Integrations > API Keys). Nodig voor zoeken en verrijken.
APOLLO_API_KEY=

# Sterk aangeraden bij publiceren: wachtwoord voor de app (gebruikersnaam is vrij te kiezen).
APP_PASSWORD=
